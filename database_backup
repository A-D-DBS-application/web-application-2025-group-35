create table public.adres (
  adres_id bigint generated by default as identity not null,
  straat text not null,
  huisnummer character varying not null,
  postcode character varying not null,
  gemeente text not null,
  land text not null default '''België''::text'::text,
  constraint Adres_pkey primary key (adres_id)
) TABLESPACE pg_default;

-- 2. Table Magazijn 
create table public.magazijn (
  magazijn_id bigint generated by default as identity not null,
  adres_id bigint not null,
  created_at timestamp with time zone not null default now(),
  constraint Magazijn_pkey primary key (magazijn_id),
  constraint Magazijn_adres_id_fkey foreign KEY (adres_id) references adres (adres_id)
) TABLESPACE pg_default;

-- 3. Table Verantwoordelijke  
create table public.verantwoordelijke (
  verantwoordelijke_id bigint generated by default as identity not null,
  voornaam text not null,
  achternaam text not null,
  email character varying not null,
  adres_id bigint not null,
  constraint verantwoordelijke_pkey primary key (verantwoordelijke_id),
  constraint Verantwoordelijke_Verantwoordelijke_id_key unique (verantwoordelijke_id),
  constraint Verantwoordelijke_adres_id_fkey foreign KEY (adres_id) references adres (adres_id)
) TABLESPACE pg_default;

-- 4. Table Kind  
create table public.kind (
  geboortedatum date not null,
  naam text not null,
  kind_id bigint generated by default as identity not null,
  verantwoordelijke_id bigint not null,
  constraint Kind_pkey primary key (kind_id),
  constraint Kind_verantwoordelijke_id_fkey foreign KEY (verantwoordelijke_id) references verantwoordelijke (verantwoordelijke_id)
) TABLESPACE pg_default;

-- 5. Table Medewerker 
create table public.medewerker (
  medewerker_id bigint generated by default as identity not null,
  voornaam character varying not null,
  achternaam character varying not null,
  werknemersnummer character varying not null,
  magazijn_id bigint not null,
  created_at timestamp with time zone not null default now(),
  constraint Medewerker_pkey primary key (medewerker_id),
  constraint Medewerker_magazijn_id_fkey foreign KEY (magazijn_id) references magazijn (magazijn_id)
) TABLESPACE pg_default;

-- 6. Item Status Type (create a specific enumerate type) 
CREATE TYPE status AS ENUM (
    'beschikbaar',
    'uitgeleend',
    'op onderhoud',
    'gearchiveerd'
);
CREATE TYPE leeftijd AS ENUM (
    '1 - 4 jaar loopfietsen',
    '2 - 3 jaar',
    '4 - 6 jaar',
    '6 - 8 jaar',
    '8 - 12 jaar',
    '14 - 16 jaar',
    'Ouder dan 16 jaar'
);
-- 7. Table Item 
create table public.item (
  itemnr bigint generated by default as identity not null,
  status public.status not null default 'beschikbaar'::status,
  leeftijdscategorie public.Leeftijd null,
  merk text not null,
  model text not null,
  verantwoordelijke_id bigint null,
  constraint Item_pkey primary key (itemnr)
) TABLESPACE pg_default;

--8. betalingswijze
CREATE TYPE "omschrijving betaling" AS ENUM (
    'Contant',
    'Kaart',
    'Overschrijven voldaan',
    'Overschrijven niet voldaan'
);

create table public.betaling (
  id bigint generated by default as identity not null,
  itemnr bigint null,
  kind_id bigint not null,
  betalingswijze "omschrijving betaling" not null,
  bedrag double precision not null,
  datum date not null,
  tijd time without time zone null default now(),
  constraint betaling_pkey primary key (id),
  constraint betaling_itemnr_fkey foreign KEY (itemnr) references item (itemnr),
  constraint betaling_kind_id_fkey foreign KEY (kind_id) references kind (kind_id) on update CASCADE
) TABLESPACE pg_default;


CREATE TYPE verhuurstatus AS ENUM (
    'Actief',
    'Beëindigd'
);
--9. verhuur
create table public.verhuur (
  verhuur_id bigint generated by default as identity not null,
  itemnr bigint not null,
  verantwoordelijke_id bigint not null,
  kind_id bigint not null,
  startdatum date not null,
  einddatum date not null,
  status public.VerhuurStatus not null default 'Actief'::"VerhuurStatus",
  constraint Verhuur_pkey primary key (verhuur_id),
  constraint Verhuur_itemnr_fkey foreign KEY (itemnr) references item (itemnr),
  constraint verhuur_kind_id_fkey foreign KEY (kind_id) references kind (kind_id) on update CASCADE on delete CASCADE
) TABLESPACE pg_default;


